{
  "beta_allowed": false,
  "caller_controlled_graph_fields": [
    "api_version",
    "body",
    "endpoint",
    "graph_endpoint",
    "headers",
    "method",
    "query",
    "query_params",
    "request_body",
    "scope",
    "scopes",
    "suffix",
    "url"
  ],
  "effects": [
