# Public identifiers only. Never place a client secret here.
M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Secure read-only default.
M365_PROFILE=read
M365_MODULES=profile,mail,calendar,files

# Strongly recommended principal restrictions.
M365_ALLOWED_USER_OBJECT_IDS=00000000-0000-0000-0000-000000000000
M365_ALLOWED_UPN_DOMAINS=example.com

# Optional resource restrictions.
M365_ALLOWED_SITE_IDS=
M365_ALLOWED_SHAREPOINT_HOSTS=example.sharepoint.com
M365_ALLOWED_TEAM_IDS=
M365_ALLOWED_CHAT_IDS=
M365_ALLOWED_GROUP_IDS=
M365_ALLOWED_PLAN_IDS=
M365_ALLOWED_APPLICATION_IDS=
M365_ALLOWED_SERVICE_PRINCIPAL_IDS=
M365_ALLOWED_CONDITIONAL_ACCESS_POLICY_IDS=

# Optional exact tool surface. Blank means all tools in enabled modules.
M365_ENABLED_TOOLS=
M365_DISABLED_TOOLS=

# Required second gate for tenant-wide/admin read modules.
M365_PRIVILEGED_MODULES_ENABLED=false

# Interactive authorization-code authentication is the default.
M365_AUTH_FLOW=interactive
M365_ALLOW_DEVICE_CODE=false
M365_TOKEN_CACHE_MODE=keyring

# Writes fail closed. Configure these only for the separate write server.
M365_WRITE_ENABLED=false
M365_PRIVILEGED_WRITES_ENABLED=false
M365_WRITE_ACTIONS=
M365_ALLOWED_RECIPIENT_DOMAINS=
M365_WRITE_RATE_LIMIT_PER_MINUTE=10
