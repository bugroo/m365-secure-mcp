# Deliberately broad example. Replace every placeholder and remove modules/tools
# your deployment does not need before an administrator grants consent.
M365_TENANT_ID=11111111-1111-4111-8111-111111111111
M365_CLIENT_ID=22222222-2222-4222-8222-222222222222
M365_PROFILE=read
M365_DEPLOYMENT_KIND=host
M365_MODULES=profile,mail,calendar,files,sites,contacts,todo,planner,teams,directory,users_admin,groups,directory_devices,organization,onenote,onenote_content,excel,excel_workbook,word,powerpoint,powerbi,people,presence,security,audit,intune,windows365,service_health,entra_apps,governance,assurance,licensing,compliance
M365_PRIVILEGED_MODULES_ENABLED=true
M365_GOVERNANCE_POLICY_PATH=/private/m365/governance-policy.signed.json
M365_GOVERNANCE_PUBLIC_KEY_PATH=/private/m365/governance-signing.pub

M365_ALLOWED_USER_OBJECT_IDS=33333333-3333-4333-8333-333333333333
M365_ALLOWED_TARGET_USER_IDS=77777777-7777-4777-8777-777777777777
M365_ALLOWED_PLANNER_ASSIGNEE_IDS=12121212-1212-4212-8212-121212121212
M365_ALLOWED_UPN_DOMAINS=example.com
M365_ALLOWED_RECIPIENT_DOMAINS=example.com
M365_ALLOWED_SITE_IDS=tenant.sharepoint.com,site-collection-id,web-id
M365_ALLOWED_SHAREPOINT_HOSTS=tenant.sharepoint.com
M365_ALLOWED_TEAM_IDS=replace-team-id
M365_ALLOWED_CHAT_IDS=replace-chat-id
M365_ALLOWED_GROUP_IDS=replace-group-id
M365_ALLOWED_DEVICE_IDS=88888888-8888-4888-8888-888888888888
M365_ALLOWED_MANAGED_DEVICE_IDS=99999999-9999-4999-8999-999999999999
M365_ALLOWED_CLOUDPC_IDS=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
M365_ALLOWED_PLAN_IDS=replace-plan-id
M365_ALLOWED_DRIVE_IDS=replace-drive-id
M365_ALLOWED_WORD_ITEM_IDS=replace-word-item-id
M365_ALLOWED_POWERPOINT_ITEM_IDS=replace-powerpoint-item-id
M365_ALLOWED_EXCEL_ITEM_IDS=replace-excel-item-id
M365_ALLOWED_ONENOTE_PAGE_IDS=replace-onenote-page-id
M365_ALLOWED_POWERBI_WORKSPACE_IDS=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
M365_ALLOWED_POWERBI_REPORT_IDS=cccccccc-cccc-4ccc-8ccc-cccccccccccc
M365_ALLOWED_POWERBI_DATASET_IDS=dddddddd-dddd-4ddd-8ddd-dddddddddddd
M365_ALLOWED_POWERBI_DASHBOARD_IDS=eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee
M365_ALLOWED_APPLICATION_IDS=44444444-4444-4444-8444-444444444444
M365_ALLOWED_SERVICE_PRINCIPAL_IDS=55555555-5555-4555-8555-555555555555
M365_ALLOWED_CONDITIONAL_ACCESS_POLICY_IDS=66666666-6666-4666-8666-666666666666
M365_ALLOWED_EDISCOVERY_CASE_IDS=ffffffff-ffff-4fff-8fff-ffffffffffff
M365_ALLOWED_RETENTION_LABEL_IDS=10101010-1010-4010-8010-101010101010

# Blank exposes every tool belonging to the modules above. For production,
# prefer an exact comma-separated list from `--list-tools`.
M365_ENABLED_TOOLS=
M365_DISABLED_TOOLS=

M365_AUTH_FLOW=interactive
M365_ALLOW_DEVICE_CODE=false
M365_PERMISSION_GRANT_MODE=admin_preconsented
M365_REJECT_UNEXPECTED_TOKEN_SCOPES=true
M365_TOKEN_CACHE_MODE=keyring
