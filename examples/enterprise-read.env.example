# Deliberately broad example. Replace every placeholder and remove modules/tools
# your deployment does not need before granting Microsoft Graph consent.
M365_TENANT_ID=11111111-1111-4111-8111-111111111111
M365_CLIENT_ID=22222222-2222-4222-8222-222222222222
M365_PROFILE=read
M365_MODULES=profile,mail,calendar,files,sites,contacts,todo,planner,teams,directory,groups,organization,onenote,excel,people,presence,security,audit,intune,service_health,entra_apps,governance,licensing
M365_PRIVILEGED_MODULES_ENABLED=true

M365_ALLOWED_USER_OBJECT_IDS=33333333-3333-4333-8333-333333333333
M365_ALLOWED_UPN_DOMAINS=example.com
M365_ALLOWED_RECIPIENT_DOMAINS=example.com
M365_ALLOWED_SITE_IDS=tenant.sharepoint.com,site-collection-id,web-id
M365_ALLOWED_SHAREPOINT_HOSTS=tenant.sharepoint.com
M365_ALLOWED_TEAM_IDS=replace-team-id
M365_ALLOWED_CHAT_IDS=replace-chat-id
M365_ALLOWED_GROUP_IDS=replace-group-id
M365_ALLOWED_PLAN_IDS=replace-plan-id
M365_ALLOWED_APPLICATION_IDS=44444444-4444-4444-8444-444444444444
M365_ALLOWED_SERVICE_PRINCIPAL_IDS=55555555-5555-4555-8555-555555555555
M365_ALLOWED_CONDITIONAL_ACCESS_POLICY_IDS=66666666-6666-4666-8666-666666666666

# Blank exposes every tool belonging to the modules above. For production,
# prefer an exact comma-separated list from `--list-tools`.
M365_ENABLED_TOOLS=
M365_DISABLED_TOOLS=

M365_AUTH_FLOW=interactive
M365_ALLOW_DEVICE_CODE=false
M365_TOKEN_CACHE_MODE=keyring
